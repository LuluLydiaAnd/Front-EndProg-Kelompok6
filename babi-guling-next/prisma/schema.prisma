generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Jenis {
  galeri
  postingan
  resto
}

model Konten {
  id          Int      @id @default(autoincrement())
  jenis       Jenis
  title       String
  description String
  image       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}